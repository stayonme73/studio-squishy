# The Studio — environment variables (repo: studio-squishy)
# Copy to .env.local for local development.

# Public site URL (optional for MVP; used in metadata and absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dev sidebar status jumpers (Studio Board pages) — off by default
# Owner QA nav is always available in local development.
# Payment page Test Payment sandbox: always on in local dev; on Vercel set below on Preview only.
# NEXT_PUBLIC_DEV_TOOLS=1
# NEXT_PUBLIC_PAYMENT_SANDBOX=1

# Decision Learner prototype — Claude predictions (server-only)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Kitchen customer voice deliverables (ElevenLabs Text-to-Speech API) ---
# Server-side only. Never expose to browser / Studio Voice / campaign records.
# Do not commit secret values. Do not paste keys into chat.
# ELEVENLABS_API_KEY=
# Optional approved voice/model overrides (IDs only — not cloning secrets):
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Kitchen short-video production (Shotstack Edit + Ingest API) ---
# Server-side only. Never expose to browser / campaign records.
# Do not commit secret values. Do not paste keys into chat.
# Use stage key for KITCHEN-VIDEO-INTEGRATION-1. Do not purchase a plan unless Owner authorizes.
# SHOTSTACK_API_KEY=
# SHOTSTACK_ENV=stage

# File Room auth — Next.js 16 uses proxy.ts (replaces middleware.ts)
# SESSION_SECRET=change-me-to-a-long-random-string

# --- Transactional email (verification + password reset only) ---
# Primary provider: Resend. Fallback (Postmark) is documented, not integrated in V1.
# Do not commit secret values.
# Production requires RESEND_API_KEY, TRANSACTIONAL_EMAIL_FROM (verified domain),
# and a non-localhost NEXT_PUBLIC_SITE_URL for verification links.
# TRANSACTIONAL_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# TRANSACTIONAL_EMAIL_FROM=Studio <noreply@your-verified-domain>
# TRANSACTIONAL_EMAIL_REPLY_TO=
# Verified sending domain required before production certification.
# Token expiration (Email Verification / Password Recovery packages):
# AUTH_EMAIL_VERIFY_TOKEN_TTL_MINUTES=60
# AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Public URL used in verification and reset links:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Client Session Timeout (authenticated customers) — defaults 30m idle / 5m warning lead.
# Cookie max age stays 7 days; inactivity ends the session sooner.
# For short certification runs (do not leave these on in production):
# NEXT_PUBLIC_AUTH_INACTIVITY_TIMEOUT_MS=120000
# NEXT_PUBLIC_AUTH_INACTIVITY_WARNING_LEAD_MS=30000

# Staff campaign assignments bridge (Slice 1b dev-only) — seeded from src/lib/file-room/campaign-assignments.seed.json
# data/campaign-assignments.json

# Allow fixture/test campaign IDs to sync to data/campaigns/ (off by default)
# ALLOW_FIXTURE_SYNC=1

# --- File Room private storage: Supabase Storage (hidden infrastructure only) ---
# Use a private bucket. Do not expose storage URLs or configure public buckets.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=studio-files
