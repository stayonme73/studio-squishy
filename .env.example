# The Studio — environment variables (repo: studio-squishy)
# Copy to .env.local for local development.

# Public site URL (optional for MVP; used in metadata and absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dev sidebar status jumpers (Studio Board pages) — off by default
# Owner QA nav is always available in local development.
# Payment page Test Payment sandbox: always on in local dev; on Vercel set below on Preview only.
# NEXT_PUBLIC_DEV_TOOLS=1
# NEXT_PUBLIC_PAYMENT_SANDBOX=1
#
# --- Stripe Checkout (hosted) — STUDIO-OPERATING-PAYMENT-TRUTH-1 ---
# Server-side only for secret + webhook. Never commit secret values.
# Use test keys during construction (sk_test_… / whsec_… / pk_test_…).
# Live keys (sk_live_…) charge real money — do not use in tests or CI.
# STRIPE_SECRET_KEY must start with sk_test_ or sk_live_ (not mk_, pk_, or other prefixes).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional explicit mode (otherwise inferred from secret key prefix):
# STRIPE_MODE=test
# Webhook endpoint (Stripe Dashboard → Developers → Webhooks):
#   POST {NEXT_PUBLIC_SITE_URL}/api/payments/webhook
#   Events: checkout.session.completed
# Complete Checkout always requires a usable Stripe secret key (opens hosted Checkout).
# Local fixture only: Test pay with sandbox confirm → preferSandbox + /api/payments/sandbox-confirm
# (synthetic session ids — never live money; not Stripe smoke proof).

# Anthropic Messages API — server-only. One key for Decision Learner,
# Design Production creative reasoning, and Copy Production writing.
# Do not commit this value. Do not paste it into chat.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# OpenAI Responses API — optional AI Studio Manager + image components.
# Dedicated Studio Manager lane. Not a personal ChatGPT thread.
# Generated images must not carry names, prices, dates, phones, URLs, or legal copy.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# --- Kitchen customer voice deliverables (ElevenLabs Text-to-Speech API) ---
# Server-side only. Never expose to browser / Studio Voice / campaign records.
# Do not commit secret values. Do not paste keys into chat.
# ELEVENLABS_API_KEY=
# Optional approved voice/model overrides (IDs only — not cloning secrets):
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Kitchen short-video production (Shotstack Edit + Ingest API) ---
# Server-side only. Never expose to browser / campaign records.
# Do not commit secret values. Do not paste keys into chat.
# Stage (sandbox) key — watermarked renders (integration testing):
# SHOTSTACK_API_KEY=
# SHOTSTACK_ENV=stage
# Production key — required for customer-candidate / cert renders (no sandbox watermark).
# Keys are environment-specific. Never use the stage key against v1.
# SHOTSTACK_PRODUCTION_API_KEY=
# For cert packages set SHOTSTACK_ENV=v1 only after Production key is present.

# --- Kitchen landing-page publish (Netlify Deploy API — static host) ---
# Server-side only. Never expose to browser / generated customer HTML.
# Free tier is sufficient for Kitchen publish proof. Do not commit secret values.
# Owner supplies the personal access token. Site/project ID may be created via
# Netlify API (POST /api/v1/sites) and persisted locally — no manual site UI required.
# NETLIFY_AUTH_TOKEN=
# NETLIFY_SITE_ID=


# Session cookies (Create Account / Sign In) — Next.js 16 uses proxy.ts (replaces middleware.ts)
# Required locally: copy to .env.local and set a long random value. Never commit .env.local.
# SESSION_SECRET=change-me-to-a-long-random-string

# --- Transactional email (verification + password reset only) ---
# Primary provider: Resend. Fallback (Postmark) is documented, not integrated in V1.
# Do not commit secret values.
# Production requires RESEND_API_KEY, TRANSACTIONAL_EMAIL_FROM (verified domain),
# and a non-localhost NEXT_PUBLIC_SITE_URL for verification links.
# TRANSACTIONAL_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# TRANSACTIONAL_EMAIL_FROM=Studio <noreply@your-verified-domain>
# TRANSACTIONAL_EMAIL_REPLY_TO=
# Verified sending domain required before production certification.
# Token expiration (Email Verification / Password Recovery packages):
# AUTH_EMAIL_VERIFY_TOKEN_TTL_MINUTES=60
# AUTH_PASSWORD_RESET_TOKEN_TTL_MINUTES=60
# Public URL used in verification and reset links:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
#
# Client Session Timeout (authenticated customers) — defaults 30m idle / 5m warning lead.
# Cookie max age stays 7 days; inactivity ends the session sooner.
# For short certification runs (do not leave these on in production):
# NEXT_PUBLIC_AUTH_INACTIVITY_TIMEOUT_MS=120000
# NEXT_PUBLIC_AUTH_INACTIVITY_WARNING_LEAD_MS=30000

# Staff campaign assignments bridge (Slice 1b dev-only) — seeded from src/lib/file-room/campaign-assignments.seed.json
# data/campaign-assignments.json

# Allow fixture/test campaign IDs to sync to data/campaigns/ (off by default)
# ALLOW_FIXTURE_SYNC=1

# --- File Room private storage: Supabase Storage (hidden infrastructure only) ---
# Use a private bucket. Do not expose storage URLs or configure public buckets.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=studio-files

# --- Durable persistence (local foundation — not production-deployed) ---
# Default: filesystem under data/. Set postgres + DATABASE_URL only when testing adapters.
# STUDIO_PERSISTENCE_BACKEND=filesystem
# DATABASE_URL=
# STUDIO_DATABASE_URL=
# SUPABASE_DB_URL=
# STUDIO_PERSISTENCE_TEST_DATABASE_URL=
# Non-secret Supabase project ref (Studio Persistence Test dashboard URL) — required before integration runs.
# STUDIO_PERSISTENCE_TEST_PROJECT_REF=
# Non-secret production ref — integration refuses if the test URL matches this ref.
# STUDIO_PERSISTENCE_PRODUCTION_PROJECT_REF=

# --- DigitalOcean clip worker (Test Preview cert — server-side only) ---
# STUDIO_HOSTED_CLIP_WORKER=1
# STUDIO_HOSTED_CLIP_WORKER_ENV=/etc/studio/worker.env
# HOSTED_CLIP_WORKER_URL=https://worker.example/run-chunk-base-without-path
# HOSTED_CLIP_COMPUTE_PROVIDER=droplet
# HOSTED_CERT_INTERNAL_CHUNK_KEY=

# --- ChatGPT ↔ Scout ops-bridge HTTPS transport (Step 2) ---
# Server-side only. Not the Owner Desk. Not the customer site.
# Local listener: npm run ops-bridge:https  (https://127.0.0.1:4178)
# Do not commit this value. Do not paste it into chat or Custom GPT instructions as a user-visible secret.
# ChatGPT Custom GPT Action should use Action authentication, not a public URL with the token in the path.
# OPS_BRIDGE_SHARED_TOKEN=
#
# Paid-activation / lifecycle sweep (server cron). Header x-studio-operating-secret
# or a staff session. Server-side only. Do not commit this value.
# STUDIO_OPERATING_SWEEP_SECRET=
# Optional TLS files when hosting later (not authorized to deploy from this package):
# OPS_BRIDGE_TLS_CERT=
# OPS_BRIDGE_TLS_KEY=
