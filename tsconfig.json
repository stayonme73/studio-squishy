{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "src/archive",
    "data",
    "test-artifacts",
    "tmp",
    "tmp-*",
    "tmp-tile-crops",
    "docs",
    "scripts/correct-room-4c-scenario-1-print.mts",
    "scripts/*room-4c*",
    "scripts/nia-photo-led-live-cert.mts",
    "scripts/project-claim-cross-device-cold-cert.mts",
    "scripts/reassemble-clip-live-delivery.ts",
    "scripts/refresh-content-pack-unusual-cert-extras.ts",
    "scripts/**/*.mts",
    "scripts/_clip-*.ts",
    "scripts/capture-*.ts",
    "scripts/generate-*.ts",
    "scripts/inspect-*.ts",
    "scripts/refresh-*.ts",
    "scripts/reinspect-*.ts",
    "scripts/remaster-*.ts",
    "scripts/repair-*.ts",
    "scripts/run-*.ts",
    "scripts/verify-clip-*.ts",
    "scripts/hosted-sfv-*.ts",
    "src/lib/studio-549-clip-repurposing-value-delivery/assemble-cert.ts",
    "src/lib/studio-549-clip-repurposing-value-delivery/index.ts",
    "src/lib/studio-549-clip-repurposing/owner-cert-correction.ts",
    "src/lib/studio-clip-repurposing-fresh-sold-contract-recert",
    "src/lib/studio-clip-repurposing-full-customer-cert",
    "src/lib/studio-clip-repurposing-launch/live-unpublished-job.ts",
    "src/lib/studio-flagship-short-form-edit/owner-qa-correction.ts",
    "src/lib/studio-room-4c-scenario-1",
    "src/lib/studio-room-4c-scenario-2",
    "src/lib/studio-room-4c-scenario-3",
    "src/lib/studio-short-form-video-editing-launch/live-paid-staging-pass.ts",
    "src/lib/studio-design-renderer/rm-j008-negative-fixture.ts",
    "**/*.test.ts"
  ]
}

